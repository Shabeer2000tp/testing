<div class="card auth-card mx-auto <%= pageType === 'single-column' ? 'single-column' : '' %>">
    <div class="row g-0">

        <!-- Left Column: Branding -->
        <div class="col-lg-5 d-none d-lg-flex auth-branding">
            <div>
                <img src="/Sslogo White-02.svg" alt="Sprint Sync Logo" class="auth-branding-logo">

                <h2 class="mb-3">Welcome Back!</h2>
                <p class="lead">
                    Sign in to access your dashboard and manage your projects.
                </p>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-7">
            <div class="card-body p-4 p-sm-5">

                <%- include('./partials/_messages.ejs') %>

                <div class="text-center text-lg-start mb-4">
                    <h4 class="mb-1">Sign In</h4>
                    <p class="text-muted mb-3">
                        Please enter your credentials to continue.
                    </p>

                    <!-- Beta Testing Notice -->
                    <div class="alert alert-warning py-2 px-3 small mb-0">
                        <div class="fw-semibold mb-2">
                            🚧 Sprint Sync is currently in beta testing.
                        </div>

                        <div class="mb-1">
                            <span class="badge bg-danger me-2">Admin</span>
                            <code>admin@test.com</code>
                            <span class="text-muted mx-2">|</span>
                            <code>Password123</code>
                        </div>

                        <div class="mb-1">
                            <span class="badge bg-success me-2">Guide</span>
                            <code>profrohiniraju@guide.com</code>
                            <span class="text-muted mx-2">|</span>
                            <code>Password123</code>
                        </div>

                        <div>
                            <span class="badge bg-primary me-2">Student</span>
                            <code>jishnub@student.com</code>
                            <span class="text-muted mx-2">|</span>
                            <code>Password123</code>
                        </div>
                    </div>
                </div>

                <form action="/login" method="POST">

                    <div class="mb-3">
                        <label for="email" class="form-label">
                            Email
                        </label>

                        <input
                            type="email"
                            class="form-control"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            required
                            autofocus>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label">
                            Password
                        </label>

                        <div class="input-group">
                            <input
                                type="password"
                                class="form-control"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                required>

                            <button
                                class="btn btn-outline-secondary"
                                type="button"
                                id="togglePassword">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-accent btn-lg">
                            Sign In
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="mb-0">
                            Don't have an account?
                            <a href="/register">Create one</a>
                        </p>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const password = document.getElementById("password");
    const toggle = document.getElementById("togglePassword");
    const icon = toggle.querySelector("i");

    toggle.addEventListener("click", () => {
        if (password.type === "password") {
            password.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            password.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    });
});
</script>
