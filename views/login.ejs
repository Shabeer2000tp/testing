<div class="card-body p-4 p-sm-5">

    <%- include('./partials/_messages.ejs') %>

    <!-- Testing Notice -->
    <div class="alert alert-info border shadow-sm mb-4">
        <h5 class="fw-bold mb-2">
            🚀 Sprint Sync - Beta Testing
        </h5>

        <p class="mb-3">
            This application is currently in the <strong>testing phase</strong>.
            Please use the demo accounts below to explore the system.
        </p>

        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Password</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-danger">Administrator</span></td>
                        <td><code>admin@test.com</code></td>
                        <td><code>Password123</code></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">Guide</span></td>
                        <td><code>profrohiniraju@guide.com</code></td>
                        <td><code>Password123</code></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">Student</span></td>
                        <td><code>jishnub@student.com</code></td>
                        <td><code>Password123</code></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <small class="text-muted mt-3 d-block">
            <strong>Note:</strong> Demo accounts are provided for testing purposes only. Data may be reset periodically.
        </small>
    </div>

    <!-- Login Header -->
    <div class="text-center text-lg-start mb-4">
        <h4 class="mb-1">Sign In</h4>
        <p class="text-muted">
            Enter your email address and password to access your account.
        </p>
    </div>

    <!-- Login Form -->
    <form action="/login" method="POST">
        <div class="mb-3">
            <label for="email" class="form-label">Email Address</label>
            <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                placeholder="Enter your email"
                required
                autofocus>
        </div>

        <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                placeholder="Enter your password"
                required>
        </div>

        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-accent btn-lg">
                Sign In
            </button>
        </div>

        <div class="text-center">
            <p class="mb-0">
                Don't have an account?
                <a href="/register">Create one</a>
            </p>
        </div>
    </form>

</div>
